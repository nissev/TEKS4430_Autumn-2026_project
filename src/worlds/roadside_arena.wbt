#VRML_SIM R2025a utf8

# Roadside terrain (M1.3). Hand-editable; only the terrain height list is produced by make_terrain.py.
# ENU (z up). Road strip at y<-3.5 (visual only), grass slope, ditch (y~0..1), back slope, forest floor (y>4).
# Rover spawn (M1.4): ~(-13, 0.4, 0.2) heading +x; robot name must be "koala_rover" (docker-compose.yml).

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"

WorldInfo {
  title "Roadside"
  basicTimeStep 16
  contactProperties [
    ContactProperties { material1 "default" material2 "default" coulombFriction [ 1.2 ] }
  ]
}
Viewpoint {
  orientation 0.15 0.2 -0.97 1.0
  position -3 12 9
}
TexturedBackground {
}
TexturedBackgroundLight {
  castShadows FALSE
}
